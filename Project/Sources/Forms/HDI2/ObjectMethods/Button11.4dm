var $elem : Object

$elem:=WP Get element by ID:C1549(WParea; _elemIDs{_elemIDs})

WP SET ATTRIBUTES:C1342($elem; wk border style:K81:29; wk solid:K81:115)
WP SET ATTRIBUTES:C1342($elem; wk border width:K81:39; "4px")
WP SET ATTRIBUTES:C1342($elem; wk border color:K81:34; _elemColors{_elemColors})


